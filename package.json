{
    "name": "omabuntu.omakasui.org",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "astro check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.12",
        "@jaamd/jaad": "^1.1.0",
        "astro": "^7.4.13",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx,astro}": [
            "oxlint --fix",
            "oxfmt --no-error-on-unmatched-pattern"
